# Movocco Android — example environment config.
# Copy this file to `.env` and fill in ONLY the public anon key.
# Never commit a real key, and NEVER put a Supabase service-role key in this app.
# No Supabase project exists yet: leave these blank until one is created and
# approved. With them blank the app runs on the labelled DEMO dataset only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
