# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Movocco: local env with real values (never commit)
.env

# Movocco: brand PNGs are generated artifacts restored from
# assets/brand/brand-assets.base64.json (see scripts/restore-brand-assets.js).
# The GitHub connector cannot push binary files, so the base64 JSON is the
# committed copy and the PNGs are restored locally before building.
assets/brand/*.png
